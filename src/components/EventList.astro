---
// Upcoming events, read live from the club's public Google Calendar.
// Until the calendar ID and API key are set, it shows src/data/fallback-events.json.
import { site } from '../site.config';
import fallback from '../data/fallback-events.json';

interface Props {
  limit?: number;
}
const { limit = 5 } = Astro.props;
---
<div
  class="events"
  data-events
  data-calendar-id={site.calendar.id}
  data-api-key={site.calendar.apiKey}
  data-tz={site.calendar.timeZone}
  data-limit={limit}
  data-fallback={JSON.stringify(fallback)}
>
  <ol class="event-list" aria-live="polite" aria-busy="true"></ol>
  <p class="event-empty" hidden>
    No events on the calendar right now. Join the Discord to hear about the next one first.
  </p>
</div>

<script>
  type Ev = { title: string; start: string; end?: string; allDay: boolean; fromGoogle?: boolean; location?: string; description?: string; url?: string };

  function stripHtml(s = '') {
    const d = document.createElement('div');
    d.innerHTML = s;
    const text = (d.textContent || '').replace(/\s+/g, ' ').trim();
    return text.length > 180 ? text.slice(0, 177).trimEnd() + '…' : text;
  }

  async function fromGoogle(id: string, key: string, limit: number): Promise<Ev[]> {
    const params = new URLSearchParams({
      key,
      timeMin: new Date().toISOString(),
      singleEvents: 'true',
      orderBy: 'startTime',
      maxResults: String(limit),
    });
    const res = await fetch(
      `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(id)}/events?${params}`,
    );
    if (!res.ok) throw new Error(`Calendar request failed: ${res.status}`);
    const data = await res.json();
    return (data.items ?? []).map((e: any) => ({
      title: e.summary ?? 'Untitled event',
      start: e.start?.dateTime ?? e.start?.date,
      end: e.end?.dateTime ?? e.end?.date,
      allDay: !e.start?.dateTime,
      fromGoogle: true,
      location: e.location,
      description: stripHtml(e.description),
      url: e.htmlLink,
    }));
  }

  function fromFallback(raw: string, limit: number): Ev[] {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    return (JSON.parse(raw) as any[])
      .map((e) => ({ ...e, allDay: !String(e.start).includes('T') }))
      .filter((e) => parseDate(e.end ?? e.start, e.allDay) >= today)
      .slice(0, limit);
  }

  // All-day dates ("2026-10-19") must be read as local dates, not UTC midnight.
  function parseDate(s: string, allDay: boolean) {
    if (allDay) {
      const [y, m, d] = s.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    return new Date(s);
  }

  function render(root: HTMLElement, events: Ev[], tz: string) {
    const list = root.querySelector('ol')!;
    const empty = root.querySelector<HTMLElement>('.event-empty')!;
    list.replaceChildren();
    list.setAttribute('aria-busy', 'false');
    empty.hidden = events.length > 0;

    const opts = (o: Intl.DateTimeFormatOptions, allDay: boolean) =>
      allDay ? o : { ...o, timeZone: tz };

    for (const e of events) {
      const start = parseDate(e.start, e.allDay);
      const li = document.createElement('li');
      li.className = 'event';

      const when = document.createElement('time');
      when.className = 'event-date';
      when.dateTime = e.start;
      const wd = document.createElement('span');
      wd.textContent = start.toLocaleDateString('en-US', opts({ weekday: 'short' }, e.allDay));
      const md = document.createElement('strong');
      md.textContent = start.toLocaleDateString('en-US', opts({ month: 'short', day: 'numeric' }, e.allDay));
      when.append(wd, md);

      const body = document.createElement('div');
      const h = document.createElement('h3');
      if (e.url) {
        const a = document.createElement('a');
        a.href = e.url;
        a.textContent = e.title;
        h.append(a);
      } else h.textContent = e.title;

      const meta = document.createElement('p');
      meta.className = 'event-meta';
      let time = e.allDay
        ? ''
        : start.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz });
      // Multi-day, date-TBA events: show the week they fall in.
      if (e.allDay && e.end && e.end !== e.start) {
        const end = parseDate(e.end, true);
        if (e.fromGoogle) end.setDate(end.getDate() - 1); // Google's all-day end date is exclusive
        if (+end > +start) {
          const d = (x: Date) => x.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          time = `${d(start)} – ${d(end)}`;
        }
      }
      meta.textContent = [time, e.location].filter(Boolean).join(', ');

      body.append(h, meta);
      if (e.description) {
        const d = document.createElement('p');
        d.className = 'event-desc';
        d.textContent = e.description;
        body.append(d);
      }
      li.append(when, body);
      list.append(li);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-events]').forEach(async (root) => {
    const { calendarId = '', apiKey = '', tz = 'America/Los_Angeles', fallback = '[]' } = root.dataset;
    const limit = Number(root.dataset.limit) || 5;
    let events: Ev[];
    try {
      events = calendarId && apiKey ? await fromGoogle(calendarId, apiKey, limit) : fromFallback(fallback, limit);
    } catch (err) {
      console.warn(err);
      events = fromFallback(fallback, limit);
    }
    render(root, events, tz);
  });
</script>

<style>
  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    min-height: 120px;
  }
  .event-list[aria-busy='true'] {
    background: repeating-linear-gradient(transparent 0 95px, var(--rule) 95px 96px);
  }
  :global(.event) {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 20px;
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
  }
  :global(.event-date) {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  :global(.event-date span) {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
  }
  :global(.event-date strong) {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  :global(.event h3) {
    font-size: var(--step-1);
    margin-bottom: 4px;
  }
  :global(.event h3 a) {
    color: var(--ink);
    text-decoration: none;
  }
  :global(.event h3 a:hover) {
    text-decoration: underline;
  }
  :global(.event-meta) {
    color: var(--muted);
    margin: 0;
  }
  :global(.event-desc) {
    margin: 6px 0 0;
  }
  .event-empty {
    padding-block: 20px;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    :global(.event) {
      grid-template-columns: 64px 1fr;
      gap: 14px;
    }
  }
</style>
