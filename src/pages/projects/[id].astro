---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, tracks, team, github, image, status } = project.data;
---
<Base title={title} description={summary}>
  <article class="wrap">
    <header class="page-head">
      <p class="back"><a href="/projects/">All projects</a></p>
      <h1>{title}</h1>
      <p>{summary}</p>
      <div class="facts">
        <span class="tag">{year}</span>
        <span class="tag">{status === 'proposed' ? 'Proposed for 2026–27' : status === 'active' ? 'In progress' : 'Complete'}</span>
        {tracks.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {image && <Image src={image} alt="" class="cover" />}

    <div class="body">
      <div class="prose"><Content /></div>
      <aside>
        {team.length > 0 && (
          <>
            <h2>Team</h2>
            <ul>{team.map((m) => <li>{m}</li>)}</ul>
          </>
        )}
        {github && (
          <a class="btn" href={github}><Icon name="github" /> View the code</a>
        )}
      </aside>
    </div>
  </article>
</Base>

<style>
  .back {
    margin-bottom: 1.5em;
    font-size: var(--step--1);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cover {
    border-radius: var(--radius-m);
    margin-bottom: 32px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
  }
  aside h2 {
    font-size: var(--step-1);
    margin-bottom: 8px;
  }
  aside ul {
    padding-left: 1.1em;
    margin: 0 0 24px;
  }
  @media (max-width: 820px) {
    .body {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
