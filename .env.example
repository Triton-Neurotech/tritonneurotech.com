# Copy to .env for local dev. In GitHub, add these under
# Settings → Secrets and variables → Actions → Variables.

# Public Google Calendar ID (Calendar settings → "Integrate calendar" → Calendar ID)
PUBLIC_GOOGLE_CALENDAR_ID=
# Google Cloud API key restricted to the Calendar API and to tritonneurotech.com
PUBLIC_GOOGLE_API_KEY=
# Formspree form ID (the part after formspree.io/f/)
PUBLIC_FORMSPREE_ID=
